# Match the owner of FORGEJO_DATA_DIR on the deployment host.
PUID=1000
PGID=1000

FORGEJO_DATA_DIR=/path/to/personal-cloud-data/forgejo/data

FORGEJO_HTTP_PORT=3002
FORGEJO_DOMAIN=git.damienmurphy.net
FORGEJO_ROOT_URL=https://git.damienmurphy.net/

# Bind SSH to the Mac mini's Tailscale address, not every host interface.
FORGEJO_SSH_BIND_ADDRESS=100.64.0.1
FORGEJO_SSH_DOMAIN=mac-mini-tailnet-name
FORGEJO_SSH_PORT=2222

DISABLE_REGISTRATION=true
REQUIRE_SIGNIN_VIEW=true

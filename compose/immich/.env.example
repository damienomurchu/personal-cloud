# Paths expand from the HOME environment variable on the Docker Compose host.
UPLOAD_LOCATION=${HOME}/personal-cloud-data/immich/library
DB_DATA_LOCATION=${HOME}/personal-cloud-data/immich/postgres
MODEL_CACHE_LOCATION=${HOME}/personal-cloud-data/immich/model-cache
EXTERNAL_LIBRARY_LOCATION=${HOME}/personal-cloud-data/immich/external

TZ=Europe/Dublin
IMMICH_VERSION=v3.3.1

# Replace before starting: openssl rand -hex 24
# Hexadecimal is alphanumeric and safe for Compose/Postgres.
DB_PASSWORD=CHANGE_ME_BEFORE_STARTING
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
